# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Database
# با RLS (002_rls.sql): این آدرس باید کاربر برنامه `auto_parts_app` باشد؛ migrate/seed را با آدرس کاربر مالک اجرا کنید
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auto_parts_dev
# آدرس کاربر برنامه برای تست ایزوله‌سازی (npm run test:e2e)
# E2E_DATABASE_URL=postgresql://auto_parts_app:رمز@localhost:5432/auto_parts_dev
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/auto_parts_test

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:4200,http://localhost:3000

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=debug

# Swagger
SWAGGER_ENABLED=true

# Tax Authority (سامانه مودیان)
TAX_AUTHORITY_API_URL=https://tp.tax.gov.ir/api
TAX_AUTHORITY_API_KEY=

# SMS Gateway
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=

# Payment Gateway
PAYMENT_PROVIDER=zarinpal
ZARINPAL_MERCHANT_ID=
# کلید رمزنگاری تنظیمات حساس (openssl rand -hex 32)
ENCRYPTION_KEY=
# آدرس عمومی بکند و فرانت (برای بازگشت از درگاه پرداخت)
APP_PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
