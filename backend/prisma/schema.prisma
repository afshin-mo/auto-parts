generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  MANAGER
  SALESMAN
  ACCOUNTANT
  WAREHOUSE
}

enum PlanType {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum PlanStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum PartyType {
  CUSTOMER
  SUPPLIER
}

enum InvoiceType {
  SALE
  PURCHASE
  SALE_RETURN
  PURCHASE_RETURN
  PROFORMA
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  SENT_TO_TAX_AUTHORITY
  PAID
  PARTIALLY_PAID
  CANCELLED
}

enum TransactionType {
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
  TRANSFER_IN
  TRANSFER_OUT
}

enum CheckStatus {
  PENDING
  CASHED
  BOUNCED
  CANCELLED
}

enum CheckType {
  RECEIVED
  PAID
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CHECK
}

enum PaymentDirection {
  RECEIVED
  PAID
}

enum ProductCodeType {
  SKU
  PART_NUMBER
  OEM
  BARCODE
  AFTERMARKET
  SUPPLIER
  OTHER
}

enum IntegrationType {
  TAX_AUTHORITY
  SMS_GATEWAY
  PAYMENT_GATEWAY
  ACCOUNTING_SOFTWARE
  ECOMMERCE
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR
}

// ═══════════════════════════════════════════════════════════════
// LAYER 1: SYSTEM MASTER DATA
// ═══════════════════════════════════════════════════════════════

model Brand {
  id          String   @id @default(uuid())
  // null = برند سیستمی (مشترک بین همه‌ی فروشگاه‌ها)؛ مقدار دار = برندی که همان فروشگاه ساخته
  tenantId    String?  @map("tenant_id")
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(50)
  country     String?  @db.VarChar(50)
  logo        String?  @db.VarChar(500)
  // VEHICLE = خودروساز ، PART = سازنده/برند قطعه
  kind        String   @default("PART") @db.VarChar(20)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicles    Vehicle[]
  products    Product[]

  @@index([tenantId])
  @@map("brands")
}

model Vehicle {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id")
  brandId     String   @map("brand_id")
  modelName   String   @map("model_name") @db.VarChar(100)
  modelCode   String?  @map("model_code") @db.VarChar(50)
  yearFrom    Int      @map("year_from")
  yearTo      Int?     @map("year_to")
  engineType  String?  @map("engine_type") @db.VarChar(100)
  fuelType    String?  @map("fuel_type") @db.VarChar(50)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand       Brand    @relation(fields: [brandId], references: [id])
  compatibilities ProductVehicleCompatibility[]

  @@index([tenantId])
  @@index([brandId])
  @@index([modelName])
  @@map("vehicles")
}

model Category {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id")
  parentId    String?  @map("parent_id")
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(50)
  description String?
  icon        String?  @db.VarChar(500)
  level       Int      @default(1)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([tenantId])
  @@index([parentId])
  @@map("categories")
}

model Unit {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id")
  name        String   @db.VarChar(50)
  code        String   @unique @db.VarChar(20)
  type        String   @db.VarChar(20)
  conversionFactor Decimal @default(1) @map("conversion_factor") @db.Decimal(10, 4)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    Product[]
  inventoryTxns InventoryTransaction[]
  invoiceItems InvoiceItem[]

  @@index([tenantId])
  @@map("units")
}

// ═══════════════════════════════════════════════════════════════
// TENANT MANAGEMENT
// ═══════════════════════════════════════════════════════════════

model Tenant {
  id              String   @id @default(uuid())
  name            String   @db.VarChar(200)
  slug            String   @unique @db.VarChar(100)
  ownerName       String   @map("owner_name") @db.VarChar(100)
  ownerPhone      String   @map("owner_phone") @db.VarChar(20)
  ownerEmail      String?  @map("owner_email") @db.VarChar(100)
  nationalId      String?  @map("national_id") @db.VarChar(20)
  economicCode    String?  @map("economic_code") @db.VarChar(50)
  
  address         String?  @db.Text
  city            String?  @db.VarChar(100)
  province        String?  @db.VarChar(100)
  postalCode      String?  @map("postal_code") @db.VarChar(20)
  phone           String?  @db.VarChar(20)
  website         String?  @db.VarChar(200)
  
  taxSystemId     String?  @map("tax_system_id") @db.VarChar(100)
  taxSystemStatus String?  @map("tax_system_status") @db.VarChar(50)
  
  planType        PlanType @default(FREE) @map("plan_type")
  planStatus      PlanStatus @default(TRIAL) @map("plan_status")
  trialEndDate    DateTime? @map("trial_end_date")
  subscriptionStart DateTime? @map("subscription_start")
  subscriptionEnd DateTime? @map("subscription_end")
  maxProducts     Int      @default(100) @map("max_products")
  maxUsers        Int      @default(1) @map("max_users")
  maxBranches     Int      @default(1) @map("max_branches")
  
  settings        Json     @default("{}")
  features        String[] @default([])
  
  isActive        Boolean  @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  users           User[]
  products        Product[]
  parties         Party[]
  invoices        Invoice[]
  inventoryTxns   InventoryTransaction[]
  warehouses      Warehouse[]
  checks          Check[]
  payments        Payment[]
  expenses        Expense[]
  smsLogs         SmsLog[]
  onlinePayments  OnlinePayment[]
  integrations    Integration[]
  auditLogs       AuditLog[]
  branches        Branch[]
  roles           Role[]
  brands          Brand[]
  units           Unit[]
  categories      Category[]
  vehicles        Vehicle[]
  productCodes    ProductCode[]
  dataImports     DataImport[]

  @@index([slug])
  @@index([ownerPhone])
  @@map("tenants")
}

model User {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String   @db.VarChar(100)
  phone         String   @unique @db.VarChar(20)
  email         String?  @db.VarChar(100)
  passwordHash  String   @map("password_hash") @db.VarChar(255)
  role          UserRole @default(SALESMAN)
  // نقش دلخواه فروشگاه؛ اگر پر باشد، دسترسی‌ها از آن نقش خوانده می‌شود (وگرنه از روی «role»)
  roleId        String?  @map("role_id")
  // true = به همه‌ی شعبه‌ها دسترسی دارد؛ false = فقط شعبه‌های جدول user_branches
  allBranches   Boolean  @default(true) @map("all_branches")
  defaultBranchId String? @map("default_branch_id")
  isActive      Boolean  @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customRole    Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  defaultBranch Branch?  @relation("UserDefaultBranch", fields: [defaultBranchId], references: [id], onDelete: SetNull)
  branches      UserBranch[]
  
  createdInvoices Invoice[] @relation("InvoiceCreator")
  createdInventoryTxns InventoryTransaction[] @relation("InventoryTxnCreator")

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("users")
}

model Branch {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String   @db.VarChar(100)
  code        String   @db.VarChar(20)
  address     String?  @db.Text
  phone       String?  @db.VarChar(20)
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouses  Warehouse[]
  users       UserBranch[]
  defaultFor  User[]   @relation("UserDefaultBranch")
  invoices    Invoice[]
  payments    Payment[]
  expenses    Expense[]
  checks      Check[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model UserBranch {
  userId    String @map("user_id")
  branchId  String @map("branch_id")
  tenantId  String @map("tenant_id")

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@id([userId, branchId])
  @@index([branchId])
  @@map("user_branches")
}

/// نقش دلخواه هر فروشگاه؛ «permissions» فهرست کلیدهای دسترسی است (src/common/permissions.ts)
model Role {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String   @db.VarChar(60)
  description String?  @db.VarChar(300)
  permissions String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

// ═══════════════════════════════════════════════════════════════
// LAYER 2: TENANT MASTER DATA
// ═══════════════════════════════════════════════════════════════

model Warehouse {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  branchId    String?  @map("branch_id")
  name        String   @db.VarChar(100)
  code        String   @db.VarChar(50)
  address     String?  @db.Text
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch?  @relation(fields: [branchId], references: [id])
  inventory   Inventory[]
  lots        InventoryLot[]
  inventoryTxns InventoryTransaction[]
  
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, branchId])
  @@map("warehouses")
}

model Product {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  
  sku             String   @db.VarChar(100)
  partNumber      String?  @map("part_number") @db.VarChar(100)
  oemCode         String?  @map("oem_code") @db.VarChar(100)
  barcode         String?  @db.VarChar(100)
  // شناسه ۱۳ رقمی کالا/خدمت در سامانه مودیان
  taxGoodsId      String?  @map("tax_goods_id") @db.VarChar(20)
  name            String   @db.VarChar(200)
  nameEn          String?  @map("name_en") @db.VarChar(200)
  description     String?  @db.Text
  
  categoryId      String?  @map("category_id")
  brandId         String?  @map("brand_id")
  unitId          String   @map("unit_id")
  
  purchasePrice   Decimal  @default(0) @map("purchase_price") @db.Decimal(15, 2)
  salePrice       Decimal  @default(0) @map("sale_price") @db.Decimal(15, 2)
  wholesalePrice  Decimal? @map("wholesale_price") @db.Decimal(15, 2)
  
  minStock        Int      @default(0) @map("min_stock")
  maxStock        Int?     @map("max_stock")
  location        String?  @db.VarChar(100)
  
  warrantyMonths  Int?     @map("warranty_months")
  attributes      Json     @default("{}")
  
  isActive        Boolean  @default(true) @map("is_active")
  isService       Boolean  @default(false) @map("is_service")
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category        Category? @relation(fields: [categoryId], references: [id])
  brand           Brand?   @relation(fields: [brandId], references: [id])
  unit            Unit     @relation(fields: [unitId], references: [id])
  
  inventory       Inventory[]
  lots            InventoryLot[]
  compatibilities ProductVehicleCompatibility[]
  substitutes     ProductSubstitute[] @relation("MainProduct")
  substitutedBy   ProductSubstitute[] @relation("SubstituteProduct")
  invoiceItems    InvoiceItem[]
  inventoryTxns   InventoryTransaction[]
  codes           ProductCode[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, barcode])
  @@index([tenantId, partNumber])
  @@index([tenantId, categoryId])
  @@index([tenantId, brandId])
  @@index([tenantId, name])
  @@map("products")
}

model ProductVehicleCompatibility {
  id          String   @id @default(uuid())
  tenantId  String @map("tenant_id")
  productId   String   @map("product_id")
  vehicleId   String   @map("vehicle_id")
  position    String?  @db.VarChar(50)
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])

  @@index([tenantId])
  @@unique([productId, vehicleId])
  @@index([productId])
  @@index([vehicleId])
  @@map("product_vehicle_compatibilities")
}

model ProductSubstitute {
  id              String   @id @default(uuid())
  tenantId  String @map("tenant_id")
  productId       String   @map("product_id")
  substituteId    String   @map("substitute_id")
  priority        Int      @default(1)
  reason          String?  @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at")

  product         Product  @relation("MainProduct", fields: [productId], references: [id], onDelete: Cascade)
  substitute      Product  @relation("SubstituteProduct", fields: [substituteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@unique([productId, substituteId])
  @@index([productId])
  @@index([substituteId])
  @@map("product_substitutes")
}

/// همه‌ی شماره‌های قابل جستجوی یک کالا (فنی/OEM، سازنده، بارکد، معادل‌های برند دیگر).
/// «codeNorm» شکل نرمال‌شده است (بدون فاصله، خط تیره، نقطه؛ حروف بزرگ؛ ارقام لاتین).
model ProductCode {
  id        String          @id @default(uuid())
  tenantId  String          @map("tenant_id")
  productId String          @map("product_id")
  type      ProductCodeType @default(OEM)
  code      String          @db.VarChar(100)
  codeNorm  String          @map("code_norm") @db.VarChar(100)
  note      String?         @db.VarChar(200)
  createdAt DateTime        @default(now()) @map("created_at")

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, codeNorm])
  @@index([tenantId, codeNorm])
  @@index([productId])
  @@map("product_codes")
}

model Inventory {
  id                String   @id @default(uuid())
  tenantId  String @map("tenant_id")
  productId         String   @map("product_id")
  warehouseId       String   @map("warehouse_id")
  quantity          Decimal  @default(0) @db.Decimal(15, 4)
  reservedQuantity  Decimal  @default(0) @map("reserved_quantity") @db.Decimal(15, 4)
  availableQuantity Decimal  @default(0) @map("available_quantity") @db.Decimal(15, 4)
  lastCountedAt     DateTime? @map("last_counted_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId])
  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
  @@map("inventory")
}

// موجودی هر کالا در هر انبار به تفکیک قیمت خرید: یک کالا با چند قیمت = چند ردیف (ادغام نمی‌شوند).
// جمع quantity ردیف‌ها همیشه برابر Inventory.quantity همان کالا/انبار است.
model InventoryLot {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  productId   String   @map("product_id")
  warehouseId String   @map("warehouse_id")
  unitCost    Decimal  @map("unit_cost") @db.Decimal(15, 2)
  quantity    Decimal  @default(0) @db.Decimal(15, 4)
  // آخرین تأمین‌کننده‌ای که با این قیمت کالا وارد کرده (برای نمایش در انبار)
  supplierName String? @map("supplier_name") @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId, unitCost])
  @@index([tenantId])
  @@index([productId, warehouseId])
  @@map("inventory_lots")
}

model Party {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  partyType       PartyType @map("party_type")
  
  name            String    @db.VarChar(200)
  code            String    @db.VarChar(50)
  nationalId      String?   @map("national_id") @db.VarChar(20)
  economicCode    String?   @map("economic_code") @db.VarChar(50)
  
  phone           String?   @db.VarChar(20)
  mobile          String?   @db.VarChar(20)
  email           String?   @db.VarChar(100)
  address         String?   @db.Text
  city            String?   @db.VarChar(100)
  postalCode      String?   @map("postal_code") @db.VarChar(20)
  
  creditLimit     Decimal?  @map("credit_limit") @db.Decimal(15, 2)
  // مشتری: مثبت = بدهکار به ما ، تأمین‌کننده: مثبت = ما بدهکاریم
  currentBalance  Decimal   @default(0) @map("current_balance") @db.Decimal(15, 2)
  // مانده‌ی اول دوره (انتقال از نرم‌افزار قبلی)؛ هم‌علامت با currentBalance و ردیف اول صورت‌حساب
  openingBalance  Decimal   @default(0) @map("opening_balance") @db.Decimal(15, 2)
  discountPercent Decimal   @default(0) @map("discount_percent") @db.Decimal(5, 2)
  
  paymentTerms    Int?      @map("payment_terms")
  notes           String?   @db.Text
  isActive        Boolean   @default(true) @map("is_active")
  
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices        Invoice[]
  checks          Check[]
  payments        Payment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, partyType])
  @@index([tenantId, phone])
  @@map("parties")
}

// ═══════════════════════════════════════════════════════════════
// LAYER 3: TRANSACTIONAL DATA
// ═══════════════════════════════════════════════════════════════

model Invoice {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  
  invoiceNumber   String        @map("invoice_number") @db.VarChar(50)
  invoiceType     InvoiceType   @map("invoice_type")
  status          InvoiceStatus @default(DRAFT)
  
  date            DateTime      @default(now())
  dueDate         DateTime?     @map("due_date")
  
  partyId         String?       @map("party_id")
  partyName       String?       @map("party_name") @db.VarChar(200)
  partyNationalId String?       @map("party_national_id") @db.VarChar(20)
  
  subtotal        Decimal       @default(0) @db.Decimal(15, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(15, 2)
  discountPercent Decimal       @default(0) @map("discount_percent") @db.Decimal(5, 2)
  vatAmount       Decimal       @default(0) @map("vat_amount") @db.Decimal(15, 2)
  vatPercent      Decimal       @default(9) @map("vat_percent") @db.Decimal(5, 2)
  totalAmount     Decimal       @default(0) @map("total_amount") @db.Decimal(15, 2)
  paidAmount      Decimal       @default(0) @map("paid_amount") @db.Decimal(15, 2)
  remainingAmount Decimal       @default(0) @map("remaining_amount") @db.Decimal(15, 2)
  
  taxAuthorityId  String?       @map("tax_authority_id") @db.VarChar(100)
  taxAuthorityRef String?       @map("tax_authority_ref") @db.VarChar(100)
  taxAuthoritySentAt DateTime?  @map("tax_authority_sent_at")
  taxAuthorityError  String?    @map("tax_authority_error") @db.Text
  // وضعیت در سامانه مودیان: PENDING | SUCCESS | FAILED (خالی = ارسال نشده)
  taxStatus          String?    @map("tax_status") @db.VarChar(20)
  taxConfirmationId  String?    @map("tax_confirmation_id") @db.VarChar(100)
  qrCode          String?       @map("qr_code") @db.Text
  
  notes           String?       @db.Text
  internalNotes   String?       @map("internal_notes") @db.Text
  /// کلید یکتای سمت کلاینت برای ثبت امن فروش آفلاین (ارسال دوباره‌ی همان فروش فاکتور تکراری نمی‌سازد)
  clientRequestId String?       @map("client_request_id")
  
  // برگشتی: شناسه فاکتور اصلی ؛ پیش‌فاکتور: شناسه فاکتوری که به آن تبدیل شده
  originalInvoiceId String?     @map("original_invoice_id")
  convertedToId   String?       @map("converted_to_id")

  branchId        String?       @map("branch_id")
  warehouseId     String?       @map("warehouse_id")

  createdBy       String        @map("created_by")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch?       @relation(fields: [branchId], references: [id])
  party           Party?        @relation(fields: [partyId], references: [id])
  creator         User          @relation("InvoiceCreator", fields: [createdBy], references: [id])
  original        Invoice?      @relation("InvoiceReturns", fields: [originalInvoiceId], references: [id])
  returns         Invoice[]     @relation("InvoiceReturns")
  
  items           InvoiceItem[]
  checks          Check[]
  payments        Payment[]
  onlinePayments  OnlinePayment[]

  @@unique([tenantId, invoiceNumber])
  @@unique([tenantId, clientRequestId])
  @@index([tenantId])
  @@index([tenantId, invoiceType])
  @@index([tenantId, status])
  @@index([tenantId, partyId])
  @@index([tenantId, date])
  @@index([tenantId, branchId, invoiceType, date])
  @@index([originalInvoiceId])
  @@map("invoices")
}

model InvoiceItem {
  id            String   @id @default(uuid())
  tenantId  String @map("tenant_id")
  invoiceId     String   @map("invoice_id")
  productId     String   @map("product_id")
  
  productName   String   @map("product_name") @db.VarChar(200)
  sku           String   @db.VarChar(100)
  
  quantity      Decimal  @db.Decimal(15, 4)
  unitId        String   @map("unit_id")
  unitPrice     Decimal  @map("unit_price") @db.Decimal(15, 2)
  
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(15, 2)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  
  vatAmount     Decimal  @default(0) @map("vat_amount") @db.Decimal(15, 2)
  vatPercent    Decimal  @default(9) @map("vat_percent") @db.Decimal(5, 2)
  
  totalPrice    Decimal  @map("total_price") @db.Decimal(15, 2)
  
  notes         String?  @db.Text
  sortOrder     Int      @default(0) @map("sort_order")
  // در فاکتور برگشتی: ردیفی از فاکتور اصلی که برگشت خورده
  originalItemId String? @map("original_item_id")
  
  createdAt     DateTime @default(now()) @map("created_at")

  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id])
  unit          Unit     @relation(fields: [unitId], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
  @@index([productId])
  @@index([originalItemId])
  @@map("invoice_items")
}

model InventoryTransaction {
  id              String          @id @default(uuid())
  tenantId        String          @map("tenant_id")
  productId       String          @map("product_id")
  warehouseId     String          @map("warehouse_id")
  
  transactionType TransactionType @map("transaction_type")
  quantity        Decimal         @db.Decimal(15, 4)
  unitId          String          @map("unit_id")
  unitCost        Decimal         @map("unit_cost") @db.Decimal(15, 2)
  totalCost       Decimal         @map("total_cost") @db.Decimal(15, 2)
  
  referenceType   String?         @map("reference_type") @db.VarChar(50)
  referenceId     String?         @map("reference_id")
  // ردیف فاکتوری که این حرکت را ساخته (برای برگشت خودکار به همان قیمت)
  referenceItemId String?         @map("reference_item_id")
  
  notes           String?         @db.Text
  batchNumber     String?         @map("batch_number") @db.VarChar(100)
  expiryDate      DateTime?       @map("expiry_date")
  
  createdBy       String          @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  unit            Unit            @relation(fields: [unitId], references: [id])
  creator         User            @relation("InventoryTxnCreator", fields: [createdBy], references: [id])

  @@index([tenantId])
  @@index([productId])
  @@index([warehouseId])
  @@index([transactionType])
  @@index([createdAt])
  @@index([referenceItemId])
  @@map("inventory_transactions")
}

model Check {
  id              String      @id @default(uuid())
  tenantId        String      @map("tenant_id")
  
  checkType       CheckType   @map("check_type")
  checkNumber     String      @map("check_number") @db.VarChar(50)
  bankName        String      @map("bank_name") @db.VarChar(100)
  branchName      String?     @map("branch_name") @db.VarChar(100)
  branchCode      String?     @map("branch_code") @db.VarChar(50)
  accountNumber   String?     @map("account_number") @db.VarChar(100)
  
  amount          Decimal     @db.Decimal(15, 2)
  dueDate         DateTime    @map("due_date")
  issueDate       DateTime?   @map("issue_date")
  
  status          CheckStatus @default(PENDING)
  
  partyId         String?     @map("party_id")
  partyName       String?     @map("party_name") @db.VarChar(200)
  
  invoiceId       String?     @map("invoice_id")
  branchId        String?     @map("branch_id")
  
  cashedAt        DateTime?   @map("cashed_at")
  bouncedReason   String?     @map("bounced_reason") @db.Text
  
  notes           String?     @db.Text
  
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  party           Party?      @relation(fields: [partyId], references: [id])
  invoice         Invoice?    @relation(fields: [invoiceId], references: [id])
  branch          Branch?     @relation(fields: [branchId], references: [id])

  @@index([tenantId])
  @@index([tenantId, checkType])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, branchId, status, dueDate])
  @@index([partyId])
  @@map("checks")
}

model Payment {
  id          String           @id @default(uuid())
  tenantId    String           @map("tenant_id")

  direction   PaymentDirection
  method      PaymentMethod
  amount      Decimal          @db.Decimal(15, 2)
  date        DateTime         @default(now())

  partyId     String?          @map("party_id")
  invoiceId   String?          @map("invoice_id")
  branchId    String?          @map("branch_id")
  reference   String?          @db.VarChar(100)
  notes       String?          @db.Text

  createdBy   String           @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch?          @relation(fields: [branchId], references: [id])
  party       Party?           @relation(fields: [partyId], references: [id])
  invoice     Invoice?         @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, branchId, date])
  @@index([partyId])
  @@index([invoiceId])
  @@map("payments")
}

model Expense {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")

  category    String        @db.VarChar(100)
  amount      Decimal       @db.Decimal(15, 2)
  date        DateTime      @default(now())
  method      PaymentMethod @default(CASH)
  description String?       @db.Text
  branchId    String?       @map("branch_id")

  createdBy   String        @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch?       @relation(fields: [branchId], references: [id])

  @@index([tenantId])
  @@index([tenantId, branchId, date])
  @@index([tenantId, date])
  @@index([tenantId, category])
  @@map("expenses")
}

// برداشت از حساب فروشگاه (شریک، کارمند یا صاحب فروشگاه). «هزینه» نیست و عمداً در سود و زیان حساب نمی‌شود.
model Withdrawal {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  branchId    String?       @map("branch_id")

  personName  String        @map("person_name") @db.VarChar(120)
  amount      Decimal       @db.Decimal(15, 2)
  method      PaymentMethod @default(CASH)
  date        DateTime      @default(now())
  description String?       @db.Text

  createdBy   String        @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([tenantId, date])
  @@index([tenantId, personName])
  @@index([tenantId, branchId, date])
  @@map("withdrawals")
}

model SmsLog {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  receptor     String   @db.VarChar(20)
  message      String   @db.Text
  provider     String   @db.VarChar(30)
  kind         String   @db.VarChar(30)
  refId        String?  @map("ref_id")
  status       String   @db.VarChar(20)
  providerRef  String?  @map("provider_ref") @db.VarChar(100)
  error        String?  @db.Text
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("sms_logs")
}

model OnlinePayment {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  invoiceId   String    @map("invoice_id")
  publicToken String    @unique @map("public_token") @db.VarChar(64)

  amount      Decimal   @db.Decimal(15, 2)
  // CREATED → PENDING (به درگاه رفته) → PAID | FAILED
  status      String    @default("CREATED") @db.VarChar(20)
  gateway     String    @default("zarinpal") @db.VarChar(30)
  authority   String?   @db.VarChar(100)
  refId       String?   @map("ref_id") @db.VarChar(100)
  cardPan     String?   @map("card_pan") @db.VarChar(30)
  error       String?   @db.Text

  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  paidAt      DateTime? @map("paid_at")
  expiresAt   DateTime  @map("expires_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice     Invoice   @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
  @@index([authority])
  @@map("online_payments")
}

model Integration {
  id              String          @id @default(uuid())
  tenantId        String          @map("tenant_id")
  type            IntegrationType
  
  config          Json            @default("{}")
  status          IntegrationStatus @default(INACTIVE)
  lastSyncAt      DateTime?       @map("last_sync_at")
  lastError       String?         @map("last_error") @db.Text
  // شمارنده‌ی سریال داخلی صورتحساب (بخشی از شماره مالیاتی)
  serialCounter   Int             @default(0) @map("serial_counter")
  
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
  @@index([tenantId])
  @@map("integrations")
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id")
  userId      String?  @map("user_id")
  
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String?  @map("entity_id")
  
  oldValues   Json?    @map("old_values")
  newValues   Json?    @map("new_values")
  
  ipAddress   String?  @map("ip_address") @db.VarChar(50)
  userAgent   String?  @map("user_agent") @db.Text
  
  createdAt   DateTime @default(now()) @map("created_at")

  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// سابقه‌ی هر بار «انتقال داده از نرم‌افزار قبلی» (برای پیگیری و عیب‌یابی)
model DataImport {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  kind      String   @db.VarChar(30)
  source    String?  @db.VarChar(100)
  fileName  String?  @map("file_name") @db.VarChar(200)
  created   Int      @default(0)
  updated   Int      @default(0)
  skipped   Int      @default(0)
  failed    Int      @default(0)
  summary   Json?
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("data_imports")
}

model SubscriptionInvoice {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  
  invoiceNumber   String   @unique @map("invoice_number") @db.VarChar(50)
  amount          Decimal  @db.Decimal(15, 2)
  period          String   @db.VarChar(50)
  
  status          String   @default("pending") @db.VarChar(50)
  paymentGateway  String?  @map("payment_gateway") @db.VarChar(50)
  paymentRef      String?  @map("payment_ref") @db.VarChar(100)
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([status])
  @@map("subscription_invoices")
}